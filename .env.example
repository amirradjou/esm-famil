# Copy to .env and fill in. Never commit .env.

# Port the server listens on (also serves the built web app in production).
PORT=3000

# Comma-separated origins allowed to connect (leave empty in production when the
# server serves the web app itself). Vite dev server default:
CORS_ORIGIN=http://localhost:5173

# --- Fact-checking (answers not found in the built-in word lists) ---
# Provider: "claude" (Anthropic API), "ollama" (local model), or "none" (word lists only).
VALIDATOR=none
# Needed when VALIDATOR=claude. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Needed when VALIDATOR=ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
