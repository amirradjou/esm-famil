# Copy to .env and fill in. Never commit .env.

# Port the server listens on (also serves the built web app in production).
PORT=3000

# Comma-separated origins allowed to connect (leave empty in production when the
# server serves the web app itself). Vite dev server default:
CORS_ORIGIN=http://localhost:5173

# --- LLM judge (optional second fact-checking tier) ---
# Every room checks answers against the built-in word database. If an LLM provider is
# configured here, hosts can additionally switch on "LLM as judge" for their room, which sends
# the answers the database does not know to the model.
# Provider: "claude" (Anthropic API), "ollama" (local model), or "none".
LLM_PROVIDER=none
# Needed when LLM_PROVIDER=claude. Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# Needed when LLM_PROVIDER=ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
